{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["core/src", "agent", "skills", "prompts", "builder", "github"],
  "exclude": ["node_modules", "dashboard", "templates", "builder/runner"]
}
