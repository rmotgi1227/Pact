{
  "name": "pact",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "agent": "tsx --env-file-if-exists=.env agent/main.ts",
    "dashboard": "pnpm -C dashboard dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bash scripts/verify/run.sh",
    "images": "docker build -f builder/Dockerfile.base -t pact-base . && docker build -t pact-runner builder/runner"
  },
  "dependencies": {
    "@pact/core": "workspace:*",
    "@octokit/rest": "^21.0.0",
    "execa": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
