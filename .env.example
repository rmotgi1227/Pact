# Copy to .env (never commit .env). No AI API keys belong here, ever.
PACT_MODEL_PROFILE=mac-dev        # mac-dev | gb10
PACT_DB=pact.db
PACT_DECIDE_MIN_P=0.82            # Tev1 confidence threshold, from infra/decide eval (85%, 17/20)
PACT_SIM_THRESHOLD=0.86           # embedding similarity for duplicate candidates
OPENCLAW_URL=                     # empty = skills run directly (fallback)
GITHUB_TOKEN=                     # repo scope on the booking-site repo
BOOKING_REPO=                     # local clone path of the booking-site repo
BOOKING_REPO_SLUG=                # owner/name
REGRESSION_PR=35
VERCEL_DEPLOY_TOKEN=              # deploy-only token for the pact-proto project
